---
const principles = [
  { n: '01', title: 'Chemistry over volume', body: 'A few promising connections beat a crowded inbox every time.' },
  { n: '02', title: 'Nearby first', body: 'The best plans are easier when the person you like is part of your actual world.' },
  { n: '03', title: 'Vibe before small talk', body: 'Hear the laugh, catch the energy, and skip the endless texting spiral.' },
  { n: '04', title: 'Personality over performance', body: 'Be yourself. No need to turn dating into a personal brand.' },
  { n: '05', title: 'Safety is table stakes', body: 'Controls, reporting, and verification belong in every step of the experience.' },
  { n: '06', title: 'Keep it human', body: 'The app should help a connection grow, then know when to get out of the way.' },
];
---

<section class="manifesto" id="manifesto">
  <div class="wrap">
    <div class="manifesto__head reveal">
      <p class="eyebrow">Manifesto</p>
      <h2>
        For people who want<br />
        <span class="accent">more than a chat.</span>
      </h2>
      <p class="lede">The principles behind every screen, swipe, and stage.</p>
    </div>

    <div class="principles">
      {
        principles.map((p, i) => (
          <article class={`principle reveal reveal-delay-${(i % 3) + 1}`}>
            <span>{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    z-index: 1;
    padding: var(--section-space) 0;
  }

  .manifesto__head {
    max-width: min(44rem, 100%);
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .eyebrow {
    color: var(--matcha-bright);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1rem;
  }

  .lede {
    color: var(--text-muted);
    font-size: var(--font-size-lede);
  }

  .principles {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .principle {
    display: grid;
    gap: 0.55rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .principle span {
    color: var(--pink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
  }

  h3 {
    font-size: var(--font-size-h3);
  }

  .principle p {
    color: var(--text-muted);
    max-width: 42ch;
  }

  @media (min-width: 800px) {
    .principle {
      grid-template-columns: 4rem 1fr 1.2fr;
      align-items: baseline;
      gap: 1.5rem;
    }

    .principle p {
      justify-self: end;
      text-align: right;
    }
  }
</style>
