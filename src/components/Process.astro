---
const steps = [
  {
    id: '01',
    title: 'Make your profile feel like you',
    body: 'Add the photos, details, and little signals that make someone want to know more.',
  },
  {
    id: '02',
    title: 'Find your kind of people',
    body: 'Browse people around you and move with intention when someone catches your attention.',
  },
  {
    id: '03',
    title: 'Say hey',
    body: 'When the feeling is mutual, start the conversation. No perfect opener required, just a reason to begin.',
  },
  {
    id: '04',
    title: 'Take it off the app',
    body: 'Join a Room, find an event, or make a plan. Let the connection leave the screen when it is ready.',
  },
];
---

<section class="process" id="process">
  <div class="wrap">
    <div class="process__head reveal">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>From first look to <span class="accent-pink">plans in real life.</span></h2>
      </div>
      <a class="btn btn-ghost" href="#download">Start here</a>
    </div>

    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class={`step reveal reveal-delay-${(i % 3) + 1}`}>
            <span class="step__id">{step.id}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    position: relative;
    z-index: 1;
    padding: var(--section-space) 0;
    background: color-mix(in srgb, var(--matcha-muted) 55%, var(--bg));
  }

  .process__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.75rem);
  }

  .eyebrow {
    color: var(--matcha-bright);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  h2 {
    font-size: var(--font-size-h2);
    max-width: 14ch;
  }

  .steps {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    padding: 1.5rem 1.35rem;
    border-radius: var(--radius);
    border: 1.5px solid var(--border);
    background: var(--bg-elevated);
  }

  .step__id {
    display: inline-block;
    margin-bottom: 1.1rem;
    color: var(--pink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
  }

  h3 {
    font-size: var(--font-size-h3);
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--text-muted);
  }

  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
