---
import AppScreenshot from './AppScreenshot.astro';
---

<section class="rooms" id="rooms">
  <div class="wrap rooms__grid">
    <div class="rooms__visual reveal" aria-hidden="true">
      <AppScreenshot
        src="/screenshots/Rooms-1.png"
        alt="M8tcha Rooms screen showing people gathered in a live room"
      />
    </div>

    <div class="rooms__copy reveal reveal-delay-1">
      <p class="eyebrow">Get past the profile</p>
      <h2>
        Check the vibe<br />
        <span class="accent">before you meet.</span>
      </h2>
      <p class="lede">
        Texting can only take you so far. Rooms let you hang out, invite people in, or just listen
        while the connection takes shape in real time.
      </p>
      <ul class="bullets">
        <li>Join when you are ready</li>
        <li>Bring someone into the conversation</li>
        <li>Move from match to Room, no pressure</li>
      </ul>
      <a class="btn btn-pink" href="#download">Join a Room</a>
    </div>
  </div>
</section>

<style>
  .rooms {
    position: relative;
    z-index: 1;
    padding: var(--section-space) 0;
  }

  .rooms__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .rooms__visual {
    display: grid;
    place-items: center;
  }

  .rooms__visual .app-screenshot {
    width: min(100%, 20rem);
  }

  .eyebrow {
    color: var(--pink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1rem;
  }

  .lede {
    color: var(--text-muted);
    max-width: 40ch;
    margin-bottom: 1.35rem;
    font-size: var(--font-size-lede);
  }

  .bullets {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
  }

  .bullets li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--text);
    font-weight: 500;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--matcha-bright);
  }

  .grid-stage {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.65rem;
    width: 100%;
    aspect-ratio: 0.92;
    min-height: min(72vw, 28rem);
    margin-inline: auto;
  }

  .tile {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.55rem;
    padding: 0.85rem;
    border-radius: 1.15rem;
    border: 1.5px solid var(--border);
    overflow: hidden;
    position: relative;
    min-height: 0;
    background: #1a1714;
  }

  .tile--host {
    grid-row: span 2;
  }

  .tile__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgba(0, 0, 0, 0.72));
    pointer-events: none;
  }

  .tile span {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (min-width: 920px) {
    .rooms__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .grid-stage {
      width: min(100%, var(--visual-size));
      aspect-ratio: 1.05;
      min-height: 0;
      gap: 0.75rem;
    }
  }
</style>
