---
import AppScreenshot from './AppScreenshot.astro';
---

<section class="events" id="events">
  <div class="wrap events__grid">
    <div class="events__copy reveal">
      <p class="eyebrow">Out in the world</p>
      <h2>Make plans worth <span class="accent-pink">leaving home for.</span></h2>
      <p class="lede">
        Find concerts, pop-ups, classes, and little local rituals that make a good first date feel
        easy. See who is interested and show up with a spark already in the room.
      </p>
      <ul class="bullets">
        <li>Recommendations shaped around your interests</li>
        <li>See what your matches are curious about</li>
        <li>Save a plan before the conversation goes cold</li>
      </ul>
      <a class="btn btn-pink" href="#download">Explore events</a>
    </div>

    <div class="events__visual reveal reveal-delay-1">
      <AppScreenshot
        src="/screenshots/Dark-Events-1.png"
        lightSrc="/screenshots/Events-1.png"
        alt="M8tcha Events screen showing nearby event recommendations"
      />
    </div>
  </div>
</section>

<style>
  .events {
    position: relative;
    z-index: 1;
    padding: var(--section-space) 0;
    background: color-mix(in srgb, var(--pink-muted) 38%, var(--bg));
  }

  .events__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
  }

  .eyebrow {
    color: var(--matcha-bright);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1rem;
  }

  .lede {
    color: var(--text-muted);
    max-width: 42ch;
    margin-bottom: 1.35rem;
    font-size: var(--font-size-lede);
  }

  .bullets {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
  }

  .bullets li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--text);
    font-weight: 500;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--pink);
  }

  .events__visual {
    display: grid;
    place-items: center;
  }

  .events__visual .app-screenshot {
    width: min(100%, 20rem);
  }

  @media (min-width: 920px) {
    .events__grid { grid-template-columns: 0.9fr 1.1fr; }
  }

  @media (max-width: 520px) {
    .event { padding: 0.8rem; gap: 0.6rem; }
    .event__date { flex-basis: 2.65rem; }
    .event__interest { display: none; }
  }
</style>