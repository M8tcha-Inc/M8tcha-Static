---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import flyerImage from '../assets/m8tcha-startup-launch-flyer.png';
import flyerImageDark from '../assets/m8tcha-startup-launch-flyer-dark.png';

const flyerDarkOptimized = await getImage({ src: flyerImageDark, widths: [400, 600, 800], formats: ['webp'] });
const flyerLightOptimized = await getImage({ src: flyerImage, widths: [400, 600, 800], formats: ['webp'] });

const shareUrl = 'https://m8tcha.com/launch-party';
const shareText = 'Join me at the M8tcha Launch Party!';

const encodedUrl = encodeURIComponent(shareUrl);
const encodedText = encodeURIComponent(shareText);

const shareLinks = [
  {
    name: 'X',
    label: 'Share on X (Twitter)',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`,
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  },
  {
    name: 'Facebook',
    label: 'Share on Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
  },
  {
    name: 'LinkedIn',
    label: 'Share on LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124M7.119 20.452H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>',
  },
  {
    name: 'WhatsApp',
    label: 'Share on WhatsApp',
    href: `https://wa.me/?text=${encodedText}%20${encodedUrl}`,
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>',
  },
];
---

<Layout
  title="M8tcha Launch Party — RSVP Now"
  description="Join the M8tcha Social Collective launch party on 11-13-26, 8PM–12AM. Drinks, music, and a first look at the app. RSVP now."
>
  <Nav />
  <main>
    <section class="launch-party">
      <div class="wrap launch-party__hero">
        <div class="launch-party__content">
          <h1 class="reveal">Join Our Launch Party!</h1>
          <p class="hero__lede reveal reveal-delay-1">
            Celebrate with us as we launch the future of connection. Enjoy drinks, music, and the
            chance to meet fellow early adopters.
          </p>
          <div class="hero__ctas reveal reveal-delay-2">
            <button class="btn btn-primary" id="rsvp-btn">RSVP Now</button>
          </div>
          <div class="share reveal reveal-delay-3">
            <p class="share__label">Share this event</p>
            <div class="share__buttons">
              {shareLinks.map((link) => (
                <a
                  class="share__btn"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.label}
                  title={link.label}
                >
                  <Fragment set:html={link.icon} />
                </a>
              ))}
              <button class="share__btn share__btn--copy" id="copy-link-btn" aria-label="Copy event link" title="Copy event link">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                </svg>
                <span class="share__copied" id="copy-feedback" hidden>Copied!</span>
              </button>
            </div>
          </div>
        </div>
        <div class="launch-party__visual reveal reveal-delay-3">
          <img
            src={flyerDarkOptimized.src}
            srcset={flyerDarkOptimized.srcSet.attribute}
            sizes="(max-width: 768px) 90vw, 45vw"
            data-dark-src={flyerDarkOptimized.src}
            data-dark-srcset={flyerDarkOptimized.srcSet.attribute}
            data-light-src={flyerLightOptimized.src}
            data-light-srcset={flyerLightOptimized.srcSet.attribute}
            alt="M8tcha Social Collective Launch Party flyer — Date: 11-13-26, Time: 8PM - 12AM"
            class="flyer-image"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <div class="modal-overlay" id="rsvp-modal" aria-hidden="true">
      <div class="modal-content">
        <button class="modal-close" aria-label="Close modal">&times;</button>
        <h2 class="modal-title">RSVP for Launch Party</h2>
        <form id="rsvp-form">
          <div class="form-grid">
            <div class="form-group">
              <label>First Name</label>
              <input
                type="text"
                name="firstName"
                placeholder="John"
                required
              />
            </div>
            <div class="form-group">
              <label>Last Name</label>
              <input
                type="text"
                name="lastName"
                placeholder="Doe"
                required
              />
            </div>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input
              type="email"
              name="email"
              placeholder="john@example.com"
              required
            />
          </div>
          <div class="form-group">
            <label>Phone Number</label>
            <input
              type="tel"
              name="phone"
              placeholder="+1 (555) 123-4567"
              required
            />
          </div>
          <button type="submit" class="btn btn-primary w-100">Submit RSVP</button>
        </form>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .launch-party {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-h) + 4rem) 0 4rem;
  }

  .launch-party__hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .launch-party__content h1 {
    font-size: var(--font-size-brand);
    margin-bottom: 1rem;
  }

  .hero__lede {
    font-size: var(--font-size-lede);
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 32rem;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .launch-party__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .flyer-image {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    transform: rotate(-2deg);
    transition: transform 0.3s var(--ease-out);
  }

  .flyer-image:hover {
    transform: rotate(0deg) scale(1.02);
  }

  /* Share Styles */
  .share {
    margin-top: 2.5rem;
  }

  .share__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .share__buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .share__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 3rem;
    height: 3rem;
    background: var(--bg-elevated);
    border: 2px solid var(--cream);
    border-radius: var(--radius);
    color: var(--text);
    box-shadow: var(--shadow);
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out),
      background 0.2s ease;
  }

  .share__btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--cream);
    background: color-mix(in srgb, var(--cream) 8%, var(--bg-elevated));
  }

  .share__btn:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .share__copied {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    background: var(--matcha-bright);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    pointer-events: none;
  }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(12, 11, 10, 0.8);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-out);
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-content {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 6vw, 3.5rem);
    max-width: 480px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: translateY(20px) scale(0.95);
    transition: transform 0.3s var(--ease-out);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
  }

  .modal-overlay.active .modal-content {
    transform: translateY(0) scale(1);
  }

  .modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 2;
  }

  .modal-close:hover {
    background: var(--pink-muted);
    color: var(--pink);
    border-color: var(--pink);
  }

  .modal-title {
    font-size: var(--font-size-h2);
    margin-bottom: 2rem;
    text-align: center;
    padding-right: 3rem;
  }

  /* Form Styles */
  #rsvp-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .form-group input {
    width: 100%;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--matcha);
    box-shadow: 0 0 0 3px var(--matcha-muted);
  }

  .w-100 {
    width: 100%;
  }

  @media (max-width: 768px) {
    .launch-party__hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__ctas {
      justify-content: center;
    }

    .launch-party__content {
      display: contents;
    }

    .launch-party__visual {
      order: -2;
    }

    .share {
      order: 1;
      margin-top: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .share__buttons {
      justify-content: center;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .modal-content {
      margin: 1rem;
      padding: 2rem 1.5rem;
    }

    .modal-title {
      font-size: clamp(1.5rem, 5vw, 2rem);
      padding-right: 0;
      text-align: left;
      margin-bottom: 1.5rem;
    }

    .modal-close {
      top: 0.5rem;
      right: 0.5rem;
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1.25rem;
    }
  }
</style>

<script>
  const modal = document.getElementById('rsvp-modal');
  const rsvpBtn = document.getElementById('rsvp-btn');
  const closeBtn = document.querySelector('.modal-close');
  const form = document.getElementById('rsvp-form') as HTMLFormElement;
  const copyBtn = document.getElementById('copy-link-btn');
  const copyFeedback = document.getElementById('copy-feedback');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.origin + '/launch-party');
      if (copyFeedback) {
        copyFeedback.hidden = false;
        setTimeout(() => {
          copyFeedback.hidden = true;
        }, 2000);
      }
    } catch {
      const fallback = document.createElement('textarea');
      fallback.value = window.location.origin + '/launch-party';
      document.body.appendChild(fallback);
      fallback.select();
      document.execCommand('copy');
      document.body.removeChild(fallback);
      if (copyFeedback) {
        copyFeedback.hidden = false;
        setTimeout(() => {
          copyFeedback.hidden = true;
        }, 2000);
      }
    }
  });

  function openModal() {
    modal?.classList.add('active');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.remove('active');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  rsvpBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  const GOOGLE_SHEETS_WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbzW2PSlB_aqvVim3EnT2M73rOVtLCOSDLl67ZFWfnt2KKfxJ6x44DLxF9xmkgA4I-h6/exec';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    const formData = {
      firstName: (form.elements.namedItem('firstName') as HTMLInputElement).value.trim(),
      lastName: (form.elements.namedItem('lastName') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      phone: (form.elements.namedItem('phone') as HTMLInputElement).value.trim(),
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    try {
      const response = await fetch(GOOGLE_SHEETS_WEB_APP_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(formData),
      });

      if (!response.ok) throw new Error('Network response was not ok');

      alert('Thank you for RSVPing! We look forward to seeing you at the launch party.');
      form.reset();
      closeModal();
    } catch (error) {
      console.error('RSVP submission failed:', error);
      alert('Something went wrong. Please try again or contact us directly.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit RSVP';
    }
  });
</script>